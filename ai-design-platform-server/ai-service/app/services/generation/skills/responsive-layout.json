{
  "name": "responsive-layout",
  "description": "响应式布局骨架（侧边栏 + 顶栏 + 内容区）",
  "parameters": {
    "appName": { "type": "string", "description": "应用名称" }
  },
  "produces": [
    {
      "path": "layouts/MainLayout.vue",
      "template": "<script setup lang=\"ts\">\nimport { ref } from 'vue'\n\nconst sidebarOpen = ref(true)\n</script>\n\n<template>\n  <div class=\"flex h-screen\">\n    <aside\n      class=\"bg-gray-900 text-white transition-all\"\n      :class=\"sidebarOpen ? 'w-64' : 'w-16'\"\n    >\n      <div class=\"p-4 font-bold text-lg\">{{appName}}</div>\n      <nav class=\"mt-4\">\n        <slot name=\"sidebar\" />\n      </nav>\n    </aside>\n    <div class=\"flex-1 flex flex-col\">\n      <header class=\"h-14 bg-white border-b flex items-center px-4\">\n        <button class=\"text-gray-600\" @click=\"sidebarOpen = !sidebarOpen\">☰</button>\n        <div class=\"flex-1\" />\n        <slot name=\"header-actions\" />\n      </header>\n      <main class=\"flex-1 overflow-auto bg-gray-50\">\n        <slot />\n      </main>\n    </div>\n  </div>\n</template>\n"
    }
  ]
}
