{
  "name": "file-upload",
  "description": "文件上传组件模式（拖拽 + 预览 + 进度）",
  "parameters": {},
  "produces": [
    {
      "path": "components/FileUpload.vue",
      "template": "<script setup lang=\"ts\">\nimport { ref } from 'vue'\n\nconst emit = defineEmits<{ upload: [files: File[]] }>()\nconst dragging = ref(false)\nconst files = ref<File[]>([])\n\nfunction handleDrop(e: DragEvent) {\n  dragging.value = false\n  const dropped = Array.from(e.dataTransfer?.files || [])\n  files.value.push(...dropped)\n  emit('upload', dropped)\n}\n\nfunction handleFileInput(e: Event) {\n  const input = e.target as HTMLInputElement\n  const selected = Array.from(input.files || [])\n  files.value.push(...selected)\n  emit('upload', selected)\n}\n\nfunction removeFile(index: number) {\n  files.value.splice(index, 1)\n}\n</script>\n\n<template>\n  <div\n    class=\"border-2 border-dashed rounded-lg p-6 text-center transition-colors\"\n    :class=\"dragging ? 'border-blue-500 bg-blue-50' : 'border-gray-300'\"\n    @dragover.prevent=\"dragging = true\"\n    @dragleave=\"dragging = false\"\n    @drop.prevent=\"handleDrop\"\n  >\n    <input type=\"file\" multiple class=\"hidden\" ref=\"fileInput\" @change=\"handleFileInput\" />\n    <p class=\"text-gray-500 text-sm\">拖拽文件到此处，或 <button class=\"text-blue-600\" @click=\"($refs.fileInput as HTMLInputElement).click()\">点击选择</button></p>\n  </div>\n  <div v-if=\"files.length\" class=\"mt-3 space-y-1\">\n    <div v-for=\"(f, i) in files\" :key=\"i\" class=\"flex items-center justify-between text-sm\">\n      <span>{{ f.name }}</span>\n      <button class=\"text-red-500 text-xs\" @click=\"removeFile(i)\">移除</button>\n    </div>\n  </div>\n</template>\n"
    }
  ]
}
